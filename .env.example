# 应用连接(omniboard_app 角色)。阶段一连生产 PG,凭据只放本仓库的 .env。
QUANT_PG_URL=postgresql://omniboard_app:...@10.0.3.240:5433/postgres
# 仅 `npm run migrate` 使用(D1:schema omniboard 归 migrator)。
QUANT_PG_MIGRATOR_URL=postgresql://...@10.0.3.240:5433/postgres
# 32 字节密钥(base64),加密 TOTP 密钥;丢失即所有人需重置验证器。生成:openssl rand -base64 32
OMNIBOARD_TOTP_KEY=
# 对外地址:Origin 校验与邀请链接用。阶段一经 SSH 隧道访问时为 http://127.0.0.1:4318
APP_ORIGIN=http://127.0.0.1:4318
PORT=4318
# 通知收件人(逗号分隔);为空时通知记为 failed(D5)
OMNIBOARD_NOTIFY_TO=
# 证据原件:设了桶就存 S3 私有桶(键 evidence/<sha256>,凭据用实例角色),生产必须设;
# 不设时存本地目录 OMNIBOARD_EVIDENCE_DIR(开发与测试)
OMNIBOARD_EVIDENCE_BUCKET=
AWS_REGION=
OMNIBOARD_EVIDENCE_DIR=data
# Connector 看板:验证结果超过多少天算过期(默认取契约的 30 天);Venue 详情「Runtime」链接的 Grafana 地址
CONNECTOR_STALE_DAYS=
GRAFANA_URL=
