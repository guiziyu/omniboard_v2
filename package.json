{
  "name": "omniboard",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "check": "vue-tsc --noEmit",
    "start": "tsx src/server/index.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "migrate": "tsx src/server/cli.ts migrate",
    "selfcheck": "tsx src/server/cli.ts selfcheck",
    "cli": "tsx src/server/cli.ts",
    "format": "prettier --write src tests scripts package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json vite.config.ts",
    "verify": "npm run format:check && npm test && npm run build",
    "test:browser": "npm run build && nice -n 19 playwright test -c tests/browser/playwright.config.ts",
    "verify:push": "npm run verify && npm run test:browser"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "elkjs": "0.12.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
